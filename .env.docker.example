# Copy to `.env` (read automatically by `docker compose`) and fill in.
# These are the build-time values Next inlines into the bundle. The anon key is
# a PUBLIC client key (RLS enforces access), so it is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Canonical origin used for magic-link redirects. localhost is fine for local runs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
